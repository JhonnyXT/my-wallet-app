rules_version = '2';

// Sync Fase 2: todavía no se sincroniza nada, así que se niega todo. Las reglas reales
// (users/{uid} solo su dueño, spaces/{id} solo sus miembros) llegan en la Fase 3 con sus tests
// contra el emulador. Ver SYNC_ROADMAP.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
