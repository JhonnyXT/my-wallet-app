rules_version = '2';

// Sync (SYNC_ROADMAP.md). Fase 3: cada usuario solo lee y escribe lo suyo, bajo users/{uid}.
// Fase 4: espacios compartidos (spaces/{id}) y códigos de invitación (inviteCodes/{code}); diseño
// en specs/sync-fase-4-espacios/design.md (D1, D9). Sin Cloud Functions: toda validación vive aquí.
// Todo lo demás se niega. Tests: firestore-tests/rules.test.ts (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function spacePath(id) {
      return /databases/$(database)/documents/spaces/$(id);
    }
    // Miembro vigente de un espacio no eliminado, antes de esta escritura.
    function isMember(id) {
      return signedIn() && exists(spacePath(id))
        && request.auth.uid in get(spacePath(id)).data.memberUids
        && get(spacePath(id)).data.get('deletedAt', null) == null;
    }
    // Lo mismo, después de la escritura (o del lote): crear el espacio y sus documentos en un
    // mismo lote, donde get() todavía no ve el espacio.
    function isMemberAfter(id) {
      return signedIn() && existsAfter(spacePath(id))
        && request.auth.uid in getAfter(spacePath(id)).data.memberUids
        && getAfter(spacePath(id)).data.get('deletedAt', null) == null;
    }
    // Antes o después: salir en un lote (leftAt + quitarse) ya no es miembro después.
    function canWrite(id) {
      return isMember(id) || isMemberAfter(id);
    }
    function isOwner(id) {
      return signedIn() && exists(spacePath(id))
        && get(spacePath(id)).data.ownerUid == request.auth.uid;
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /spaces/{id} {
      // Incluye un espacio eliminado (deletedAt): así sus miembros se enteran.
      allow get: if signedIn() && request.auth.uid in resource.data.memberUids;
      // Descubrir mis espacios: query con where("memberUids", "array-contains", uid).
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.get('deletedAt', null) == null;
      allow update: if signedIn() && (
        // Dueño: quitar a otros (nunca agregar) y eliminar (deletedAt). Sigue siendo miembro.
        (resource.data.ownerUid == request.auth.uid
          && changedOnly(['memberUids', 'deletedAt', 'serverUpdatedAt'])
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids)
        // Unirse: un no miembro se agrega solo a sí mismo, con un código vigente de ESTE espacio.
        || (!(request.auth.uid in resource.data.memberUids)
          && resource.data.get('deletedAt', null) == null
          && changedOnly(['memberUids', 'joinCode', 'serverUpdatedAt'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.joinCode is string
          && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinCode))
          && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinCode)).data.spaceId == id
          && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinCode)).data.expiresAt > request.time)
        // Salir: un miembro que no es el dueño solo se quita a sí mismo.
        || (request.auth.uid in resource.data.memberUids
          && resource.data.ownerUid != request.auth.uid
          && changedOnly(['memberUids', 'serverUpdatedAt'])
          && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid]))
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // El dueño también lee un espacio ya marcado como eliminado: tiene que listarlo para borrarlo.
      // Una persona por documento, con o sin app (uid null = sin app). leftAt = salió o la quitaron.
      match /members/{memberId} {
        allow read: if isMember(id) || isOwner(id);
        allow create: if canWrite(id)
          && (request.resource.data.get('uid', null) == null
            || request.resource.data.uid == request.auth.uid);
        allow update: if canWrite(id) && (
          // Reclamar a una persona sin app ("soy Ana"): solo si sigue libre.
          (resource.data.get('uid', null) == null
            && request.resource.data.get('uid', null) == request.auth.uid)
          // Editar sin tocar el uid: una persona sin app (cualquiera), uno mismo, o el dueño.
          || (request.resource.data.get('uid', null) == resource.data.get('uid', null)
            && (resource.data.get('uid', null) == null
              || resource.data.uid == request.auth.uid
              || isOwner(id)))
        );
        allow delete: if isOwner(id);
      }

      // Lo compartido de la lista: nombre, ícono, categorías, mostrar ingresos.
      match /config/{doc} {
        allow read: if isMember(id) || isOwner(id);
        allow create, update: if canWrite(id);
        allow delete: if isOwner(id);
      }

      // Cualquier miembro registra, edita o borra (lógico) cualquier movimiento, como en una lista
      // en papel. Borrar de verdad solo el dueño, al eliminar el espacio.
      match /transactions/{tx} {
        allow read: if isMember(id) || isOwner(id);
        allow create, update: if isMember(id);
        allow delete: if isOwner(id);
      }
    }

    // Códigos de invitación. Se leen solo sabiendo el código (sin list ajeno: no se enumeran).
    match /inviteCodes/{code} {
      allow get: if signedIn();
      // Solo los propios (para borrarlos al eliminar el espacio).
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      // create no pisa uno existente (eso sería update, que no se permite).
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.spaceId is string
        && isMember(request.resource.data.spaceId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
