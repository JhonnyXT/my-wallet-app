# Copiar a .env.local (desarrollo) o cargar en Vercel → Settings → Environment Variables.

# Baja de la lista de espera (ver src/lib/waitlist.ts). Las altas viven en joblan.
RESEND_API_KEY=
# Opcional: por defecto usa el topic "MyWallet — Lanzamiento" ya creado en Resend.
RESEND_TOPIC_ID=

# URL pública del sitio (metadatos, Open Graph, hreflang).
NEXT_PUBLIC_SITE_URL=https://example.com
