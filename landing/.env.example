# Copiar a .env.local (desarrollo) o cargar en Vercel → Settings → Environment Variables.

# Lista de espera → contactos de Resend (ver src/lib/waitlist.ts).
RESEND_API_KEY=
# Opcional: segmento de Resend donde agrupar a la lista de espera.
RESEND_SEGMENT_ID=

# URL pública del sitio (metadatos, Open Graph, hreflang).
NEXT_PUBLIC_SITE_URL=https://example.com
