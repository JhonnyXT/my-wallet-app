# Copiar a .env.local (desarrollo) o cargar en Vercel → Settings → Environment Variables.

# Lista de espera → contactos de Resend (ver src/lib/waitlist.ts). Misma
# cuenta/audiencia que meld-app/landing, separados por segmento y topic.
RESEND_API_KEY=
# Opcionales: por defecto usa el segmento y topic "MyWallet — Waitlist" /
# "MyWallet — Lanzamiento" ya creados en el dashboard de Resend (ver
# src/lib/waitlist.ts). Solo hace falta definirlos si se recrean.
RESEND_SEGMENT_ID=
RESEND_TOPIC_ID=

# URL pública del sitio (metadatos, Open Graph, hreflang).
NEXT_PUBLIC_SITE_URL=https://example.com
