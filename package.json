    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-jest": "^30.4.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
