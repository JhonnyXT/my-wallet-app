    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/native": "^7.1.28",
    "expo": "~55.0.4",
    "expo-blur": "~55.0.8",
    "expo-constants": "~55.0.7",
    "expo-crypto": "~55.0.19",
