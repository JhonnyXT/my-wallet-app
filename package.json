    "expo-linking": "~55.0.7",
    "expo-local-authentication": "~55.0.18",
    "expo-notifications": "~55.0.13",
    "expo-router": "~55.0.3",
    "expo-sharing": "~55.0.14",
    "expo-speech-recognition": "^3.1.1",
    "expo-splash-screen": "~55.0.10",
    "expo-sqlite": "^55.0.10",
    "expo-status-bar": "~55.0.4",
